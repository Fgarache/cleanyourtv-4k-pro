<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:importantForAccessibility="no">

    <LinearLayout
        android:id="@+id/screensaverClockBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:paddingStart="56dp"
        android:paddingTop="26dp"
        android:orientation="vertical"
        android:focusable="false">

        <TextClock
            android:id="@+id/date"
            android:gravity="left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:format12Hour="@string/date_format_home"
            android:format24Hour="@string/date_format_home"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.20"
            android:textAllCaps="true"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="52sp"
                android:fontFamily="@string/font_light"
                android:letterSpacing="-0.04"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="12" />

            <TextClock
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="8dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#F2FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-left over the audio spectrum: large spinning vinyl disc + large song title + artist -->
    <LinearLayout
        android:id="@+id/screensaverMediaRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:paddingStart="52dp"
        android:paddingBottom="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.gathin.tvhome.SpinningVinylView
            android:id="@+id/screensaverMediaDisc"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginEnd="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screensaverMediaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="720dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:fontFamily="@string/font_medium"
                android:shadowColor="#F2000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10" />

            <TextView
                android:id="@+id/screensaverMediaArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxWidth="720dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#E0FFFFFF"
                android:textSize="20sp"
                android:fontFamily="@string/font_regular"
                android:shadowColor="#F2000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
